# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Vite отдаёт в браузер ТОЛЬКО переменные с префиксом VITE_.
# Секреты (ключи, client secret) без VITE_ — их должен читать серверный RAG-сервис (Этап 7-8), не фронтенд.

# --- Фронтенд ---
# Адрес RAG-сервиса, к которому обращается чат ассистента (Этап 7)
VITE_RAG_API_URL=http://localhost:8787

# --- RAG-сервис (серверная часть) ---
RAG_PORT=8787
# Локальная папка с базой знаний
RAG_DIR=./rag

# Google Gemini для генерации ответов (Этап 7). Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Google Drive коннектор (Этап 8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# ID папки на Google Drive, которая синхронизируется в rag/
GOOGLE_DRIVE_FOLDER_ID=

# Адрес фронтенда: сюда возвращается пользователь после OAuth
FRONTEND_URL=http://localhost:5173

# Вариант без OAuth: ключ сервисного аккаунта (JSON). Тогда папку Drive нужно открыть на его email.
# GOOGLE_SERVICE_ACCOUNT_FILE=./server/google-service-account.json
